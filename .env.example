# Copie este arquivo para .env e preencha SE quiser configurar a API Key via variáveis de
# ambiente em vez da tela "Configuração" do dashboard. Ambas as formas funcionam; variáveis
# de ambiente têm prioridade. Deixe em branco (ou não crie o .env) para configurar pela tela.
FORTICNAPP_KEY_ID=
FORTICNAPP_SECRET=
FORTICNAPP_ACCOUNT=
